---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../components/BaseLayout.astro";
import ConceptCard from "../../components/ConceptCard.astro";
import Icon from "../../components/Icon.astro";
import { branchOf } from "../../lib/site";
import VoteBox from "../../components/islands/VoteBox.tsx";

export async function getStaticPaths() {
  const concepts = await getCollection("concepts");
  return concepts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const c = entry.data;
const b = branchOf(c.branch);
const { Content } = await render(entry);

const concepts = await getCollection("concepts");
const related = c.related
  .map((id) => concepts.find((x) => x.id === id))
  .filter((x): x is NonNullable<typeof x> => Boolean(x));

/** Some ideas have a story told alongside them — a myth, a parable, a thought
 *  experiment. The story is the hook; this is the link back to it. */
const stories = await getCollection("stories");
const story = stories.find((s) => s.data.ideas.includes(entry.id));
---

<BaseLayout title={`${c.title} — Little Thinker`} description={c.hook}>
  <article class="detail idea-detail" style={`--card-accent:${b.color}`}>
    <nav class="crumbs">
      <a href="/">Home</a><span aria-hidden="true">/</span>
      <a href="/ideas">Big Ideas</a><span aria-hidden="true">/</span>
      <span aria-current="page">{c.title}</span>
    </nav>

    <header class="detail-head compact">
      <div>
        <p class="kicker"><Icon name="idea" size={14} /> {b.name} · ages {c.agesMin}–{c.agesMax}</p>
        <h1>{c.title}</h1>
        <p class="hook">{c.hook}</p>
      </div>
    </header>

    <div class="detail-body">
      <div class="prose">
        <Content />

        <section class="tryit">
          <p class="tryit-label"><Icon name="compass" size={15} /> Try it</p>
          <p set:html={c.tryIt} />
        </section>

        {/* The vote asks for a stance on the question itself, so the same
            three buttons make sense on every idea. The specific discussion
            questions live in "Talk about it" below — using talk[0] here
            printed it twice. */}
        <VoteBox
          client:visible
          slug={entry.id}
          question="Do you think there is a right answer to this question?"
        />

        <section class="talk">
          <p class="tryit-label"><Icon name="speech" size={15} /> Talk about it</p>
          <ul class="talk-list">
            {c.talk.map((t) => <li set:html={t} />)}
          </ul>
        </section>

        {
          c.objections.length > 0 && (
            <section class="objections">
              <p class="tryit-label">
                <Icon name="knot" size={15} /> Yes, but… — the arguments people actually make
              </p>
              <ul class="objection-list">
                {c.objections.map((o) => (
                  <li>
                    <p class="objection-q" set:html={o.challenge} />
                    <p class="objection-a" set:html={o.reply} />
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          c.keyThinkers.length > 0 && (
            <section class="thinkers">
              <p class="tryit-label">
                <Icon name="scales" size={15} /> What other philosophers think
              </p>
              <ul class="thinker-list">
                {c.keyThinkers.map((k) => (
                  <li>
                    <b>{k.who}</b>
                    <span set:html={k.view} />
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          c.goFurther.length > 0 && (
            <section class="gofurther">
              <p class="tryit-label">
                <Icon name="scroll" size={15} /> If you want to go further
              </p>
              <ul class="source-list">
                {c.goFurther.map((g) => (
                  <li>
                    <b>{g.title}</b> — {g.who}
                    <span set:html={g.note} />
                  </li>
                ))}
              </ul>
              <p class="side-small">
                Most of these were written for adults, which is why it is worth reading them with someone older.
              </p>
            </section>
          )
        }

      </div>

      <aside class="sidebox">
        {
          related.length > 0 && (
            <div class="side-block">
              <p class="side-h">Goes with</p>
              {related.map((r) => (
                <a class="side-link" href={`/ideas/${r.id}`}>
                  {r.data.title}
                  <span>{branchOf(r.data.branch).name}</span>
                </a>
              ))}
            </div>
          )
        }

        {
          story && (
            <div class="side-block">
              <p class="side-h">A story to go with this</p>
              <a class="side-link" href={`/stories/${story.id}`}>
                {story.data.title}
                <span>{story.data.source}</span>
              </a>
            </div>
          )
        }

        <div class="side-block">
          <p class="side-h">Thinkers on this theme</p>
          {(await getCollection("philosophers"))
            .filter((p) => p.data.branch === c.branch)
            .slice(0, 3)
            .map((p) => (
              <a class="side-link" href={`/philosophers/${p.id}`}>
                {p.data.name}
                <span>{p.data.bigQuestion}</span>
              </a>
            ))}
        </div>

        <div class="side-block">
          <p class="side-h">Read alone or together</p>
          <p class="side-small">
            Works read silently, or read aloud by an adult. The &ldquo;Try it&rdquo; box is the part that makes it
            stick.
          </p>
        </div>

        <div class="side-block">
          <p class="side-h">Teachers</p>
          <p class="side-small"><a href="/grown-ups">Ten-minute lesson ritual &rarr;</a></p>
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>
