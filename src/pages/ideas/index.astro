---
import { getCollection } from "astro:content";
import BaseLayout from "../../components/BaseLayout.astro";
import ConceptCard from "../../components/ConceptCard.astro";
import AgeRangeChart from "../../components/charts/AgeRangeChart.astro";
import FilterChips from "../../components/islands/FilterChips.tsx";
import Icon from "../../components/Icon.astro";
import { branchList } from "../../lib/site";

const concepts = await getCollection("concepts");
const groups = branchList
  .map((b) => ({ ...b, items: concepts.filter((c) => c.data.branch === b.key) }))
  .filter((g) => g.items.length > 0);

const ladder = concepts.map((c) => ({
  title: c.data.title,
  branch: c.data.branch,
  agesMin: c.data.agesMin,
  agesMax: c.data.agesMax,
  href: `/ideas/${c.id}`,
}));

const wordNumber = ["", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten", "eleven", "twelve", "thirteen", "fourteen"];
const totalWord = wordNumber[concepts.length] ?? String(concepts.length);
---

<BaseLayout
  title="Big Ideas — Think Small"
  description="Philosophical concepts explained for children: fairness, friendship, courage, truth, time, beauty and more."
>
  <header class="page-head">
    <p class="kicker">The big ideas</p>
    <h1>{totalWord.charAt(0).toUpperCase() + totalWord.slice(1)} questions with no answer at the bottom</h1>
    <p class="lede">
      Every page has the same four parts: the question, the story, a thing to try, and questions to argue about on the
      way home. Grouped by what the idea is about.
    </p>
    <figure class="mt-5.5">
      <img
        src="/illustration-ladder.svg"
        alt="A small figure looking up at a ladder leaning against a giant question mark, with a trail of stars"
        width="800"
        height="400"
        class="h-auto w-full rounded-page border-[1.5px] border-ink bg-paper-2"
      />
    </figure>
    </header>

  <div class="filterbar">
    <FilterChips
      client:load
      kind="ageBand"
      target=".branch"
      hideEmptyGroups=".branch"
      ariaLabel="Filter by age"
      options={[
        { value: "all", label: "All ages" },
        { value: "5", label: "5+" },
        { value: "7", label: "7+" },
        { value: "9", label: "9+" },
      ]}
    />
    <p class="filter-count" id="c-count"></p>
  </div>

  <AgeRangeChart ideas={ladder} />

  {
    groups.map((g) => (
      <section class="branch" style={`--card-accent:${g.color}`}>
        <div class="branch-head">
          <h2>
            <Icon name="leaf" size={18} />
            {g.name}
          </h2>
          <p>{g.note}</p>
        </div>
        <div class="grid grid-3">
          {g.items.map((c) => (
            <ConceptCard entry={c} />
          ))}
        </div>
      </section>
    ))
  }
</BaseLayout>
