---
import BaseLayout from "../components/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import wonders from "../data/wonders.json";

// Seed questions, rendered server-side so the wall is never empty for a
// reader with JavaScript off. The client script prepends the visitor's own.
const seed = [
  { q: "Why do we have to sleep?", a: "Afnan, 7" },
  { q: "Is my dog happy?", a: "Rui, 6" },
  { q: wonders[0], a: "Maya, 11" },
  { q: "If I swap bodies with my friend, who is who?", a: "Josef, 10" },
  { q: "Why does time move only one way?", a: "Nadia, 9" },
  { q: "Is it rude to think bad things about someone?", a: "Tom, 8" },
];
---

<BaseLayout title="Wonder Wall — Think Small" description="Questions children have sent us, and how to ask a good one.">
  <header class="page-head">
    <p class="kicker">The wonder wall</p>
    <h1>Questions we have been sent</h1>
    <p class="lede">
      A question is the smallest unit of philosophy. Add one — it stays on your device and is waiting for you next time.
    </p>
  </header>

  <form class="wonder-form" id="wonder-form">
    <label for="wonder-input">What do you wonder about?</label>
    <div class="wf-row">
      <input
        id="wonder-input"
        type="text"
        maxlength="120"
        placeholder="Why do we have to sleep?"
        required
        aria-describedby="wf-hint"
      />
      <button class="btn" type="submit">Put it on the wall</button>
    </div>
    <p class="wf-hint" id="wf-hint">
      Nothing is sent anywhere. No account, no name, no email, no tracking — your question is saved in this browser only.
    </p>
  </form>

  <div class="wall" id="wall" aria-live="polite"></div>
  <div id="wall-seed" hidden>
    {seed.map((s) => (
      <div class="wq">
        {s.q}
        <small>Sent in by {s.a}</small>
      </div>
    ))}
  </div>

  <section class="how">
    <h2>What makes a good wonder?</h2>
    <ol class="how-list">
      <li>
        <b>It can&rsquo;t be looked up</b>
        <span>&ldquo;How tall is Everest?&rdquo; is a fact question. &ldquo;Why do we climb anything?&rdquo; is a wonder.</span>
      </li>
      <li>
        <b>Two people can disagree</b>
        <span>If everyone would answer the same, there is nothing to think about.</span>
      </li>
      <li>
        <b>It nags you</b>
        <span>The good ones come back in the bath.</span>
      </li>
      <li>
        <b>It starts with a word you use every day</b>
        <span>Fair. Real. Kind. Good. Those are the ones nobody has finished answering.</span>
      </li>
    </ol>
    <p class="how-foot"><span style="color:var(--muted); font-size:0.9rem">
      <Icon name="knot" size={14} /> Grown-ups: <a href="/grown-ups">how to run this in ten minutes</a>
    </span></p>
  </section>
</BaseLayout>
