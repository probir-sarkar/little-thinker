---
import BaseLayout from "../../components/BaseLayout.astro";

/**
 * The book's landing page.
 *
 * The book itself is generated from the same stories by scripts/book.mjs:
 *   HTML → WeasyPrint  = PDF (page numbers, real contents list)
 *        → pandoc      = EPUB
 * This page only offers it. Reading online is /stories; nothing is laid out twice.
 */
const R2 = "https://pub-73ba21a85584404aad016046b7da70d7.r2.dev/little-thinker/book";
---

<BaseLayout
  title="Philosophy for Children — Little Thinker"
  description="One volume in three parts: twenty stories, thirty-three thinkers, fifty-four questions. Free as a PDF, an EPUB and a Kindle file."
  image={`${R2}/cover.png`}
  imageAlt="Cover of Twenty Questions for the Table"
  imageWidth={1240}
  imageHeight={1754}
>
  <article class="book">
    <div class="book-grid">
      <div class="book-copy">
        <p class="kicker">The book</p>
        <h1>Philosophy<br />for Children</h1>
        <p class="lede">
          Twenty stories and the questions they leave. Retold plainly, each one ending in the question it was
          invented to ask. Read one aloud, stop at the question, and wait.
        </p>
        <p class="meta">Ages 6–12 · read aloud</p>

        <div class="dl">
          <a class="btn" href={`${R2}/philosophy-for-children.pdf`}>PDF <span>A4, print-ready</span></a>
          <a class="btn" href={`${R2}/philosophy-for-children.epub`}>EPUB <span>phones and e-readers</span></a>
          <a class="btn" href={`${R2}/philosophy-for-children.docx`}>Kindle <span>DOCX for Amazon KDP</span></a>
        </div>

        <p class="fine">
          Every entry names where it comes from. The words are ours; the stories, the thinkers and the arguments are older than any of us.
          <a href="/stories">Read them online instead</a>.
        </p>
      </div>

      <figure class="book-cover">
        <img
          src={`${R2}/cover.png`}
          alt="Cover of Philosophy for Children: the title set in a serif on a cream page, above a line drawing of an open book and a question mark"
          width="1240"
          height="1754"
        />
      </figure>
    </div>
  </article>
</BaseLayout>

<style>
  .book {
    max-width: 64rem;
    margin: 0 auto;
    padding: 3rem 1.25rem 5rem;
  }
  .book-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: start;
  }
  @media (min-width: 52rem) {
    .book-grid {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 3.5rem;
    }
  }
  .kicker {
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-muted, #6b6257);
    margin: 0 0 0.8rem;
  }
  h1 {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5.2vw, 3.4rem);
    line-height: 1.03;
    letter-spacing: -0.02em;
    margin: 0 0 1.2rem;
  }
  .lede {
    font-size: 1.05rem;
    line-height: 1.6;
    max-width: 42ch;
    margin: 0 0 0.9rem;
  }
  .meta {
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    color: var(--color-muted, #6b6257);
    margin: 0 0 2rem;
  }
  .dl {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 0 0 1.6rem;
  }
  .btn {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.85rem 1.3rem;
    border: 1.5px solid var(--color-ink, #2a2118);
    border-radius: 10px;
    text-decoration: none;
    color: inherit;
    font-weight: 700;
    line-height: 1.2;
    background: var(--color-paper-2, #f6efe0);
  }
  .btn span {
    font-weight: 400;
    font-size: 0.78rem;
    color: var(--color-muted, #6b6257);
  }
  .btn:hover {
    background: var(--color-ink, #2a2118);
    color: var(--color-paper, #fbf7ee);
  }
  .btn:hover span {
    color: inherit;
    opacity: 0.78;
  }
  .fine {
    font-size: 0.86rem;
    line-height: 1.55;
    color: var(--color-muted, #6b6257);
    max-width: 44ch;
    margin: 0;
  }
  .fine a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .book-cover {
    margin: 0;
    justify-self: center;
    max-width: 21rem;
    width: 100%;
  }
  .book-cover img {
    width: 100%;
    height: auto;
    display: block;
    border: 1px solid color-mix(in srgb, var(--color-ink) 15%, transparent);
    border-radius: 4px;
  }
</style>
