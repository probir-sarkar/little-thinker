---
import { getCollection } from "astro:content";
import BaseLayout from "../../components/BaseLayout.astro";

/**
 * The book. Same twenty retellings as /stories, laid out to be read from a
 * screen or printed and stapled: one story per spread, the question set apart,
 * and no answers anywhere.
 */
const stories = (await getCollection("stories")).sort(
  (a, b) => a.data.agesMin - b.data.agesMin || a.data.title.localeCompare(b.data.title),
);

const bodyToParagraphs = (body: string) =>
  body
    .split(/\n{2,}/)
    .map((p) => p.trim())
    .filter(Boolean)
    .map((p) => p.replace(/\n/g, " "));
---

<BaseLayout
  title="The Little Thinker book — Little Thinker"
  description="Twenty old stories and the questions they leave open. Free to read, free to print."
>
  <article class="book">
    <section class="cover">
      <p class="cover-kicker">Little Thinker</p>
      <h1>Twenty questions<br />for the table</h1>
      <p class="cover-sub">
        Old stories — a cave, a ring, a ship — each one ending in a question nobody has settled.
      </p>
      <p class="cover-note">Philosophy for children · ages 6–12 · read it aloud</p>
      <p class="cover-dl"><a href="https://pub-73ba21a85584404aad016046b7da70d7.r2.dev/little-thinker/printables/little-thinker-book.pdf">Download the PDF</a> — or print this page.</p>
      <img
        class="cover-art"
        src="/illustration-stories.svg"
        alt="An open book on the ground with a dotted trail rising from its pages toward a question mark, under a crescent moon"
        width="800"
        height="400"
      />
      <p class="cover-imprint">little-thinker.browserstay.com</p>
    </section>

    <section class="front">
      <h2>How to use this book</h2>
      <p>
        Every story here is old, and every one of them was told to make somebody think rather than to make a point.
        None of them ends in an answer, on purpose. Read one aloud. Stop at the question. Then wait — the waiting is the
        part that works.
      </p>
      <p>
        If you are reading with a child, do not rescue them from the difficulty. If you are reading alone, write your
        answer down; a written answer is much easier to disagree with later. The stories get longer and heavier as the
        book goes on, and the ages printed with each story are a suggestion, not a rule.
      </p>
      <section class="contents-block">
        <h2>Contents</h2>
        <p class="contents-note">Each story names where it comes from; the ages are printed with the story.</p>
        <ol class="contents">
        {
          stories.map((s) => (
            <li>
              <span>{s.data.title}</span>
              <em>{s.data.sourceShort}</em>
            </li>
          ))
        }
        </ol>
      </section>
    </section>

    {
      stories.map((s, i) => (
        <section class="chapter">
          <p class="ch-num">{String(i + 1).padStart(2, "0")}</p>
          <h2>{s.data.title}</h2>
          <p class="ch-src">
            {s.data.source} · ages {s.data.agesMin}–{s.data.agesMax}
          </p>
          {bodyToParagraphs(s.body ?? "").map((p) => <p set:html={p} />)}
          <div class="ch-ask">
            <p class="ch-ask-label">Stop here. Ask:</p>
            <p class="ch-ask-q">{s.data.ask}</p>
          </div>
          <p class="ch-note">{s.data.sourceNote}</p>
        </section>
      ))
    }

    <section class="back">
      <h2>Where these stories come from</h2>
      <p>
        Nothing in this book is invented. Each story is a retelling of something older — a Greek fable, a Chinese
        parable, a thought experiment from Plato, a Buddhist teaching, a folktale with no author left to thank. The
        words are ours; the stories are not. Every page names its source, and the website links the edition used.
      </p>
      <p class="back-end">
        little-thinker.browserstay.com — free, no accounts, no adverts, nothing collected.
      </p>
    </section>
  </article>
</BaseLayout>

<style>
  .book {
    max-width: 46rem;
    margin: 0 auto;
    padding: 2rem 1.25rem 5rem;
    font-family: var(--font-body);
    color: var(--color-ink, #2a2118);
  }

  .cover {
    min-height: 60vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1rem;
    padding: 3rem 0;
    border-bottom: 1.5px solid var(--color-ink, #2a2118);
  }
  .cover-kicker {
    font-size: 0.78rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-muted, #6b6257);
  }
  .cover h1 {
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 7vw, 4.2rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .cover-sub {
    font-size: 1.1rem;
    line-height: 1.5;
    max-width: 34ch;
    margin: 0;
  }
  .cover-note,
  .cover-imprint {
    font-size: 0.82rem;
    color: var(--color-muted, #6b6257);
    margin: 0;
  }
  .cover-dl {
    font-size: 0.9rem;
    margin: 0.2rem 0 0;
  }
  .cover-dl a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .cover-art {
    width: 100%;
    max-width: 30rem;
    height: auto;
    margin-top: 1.5rem;
  }
  .cover-imprint {
    margin-top: 1.25rem;
    letter-spacing: 0.06em;
  }

  .front,
  .back {
    padding: 2.5rem 0 1rem;
    border-bottom: 1.5px solid var(--color-ink, #2a2118);
  }
  .front h2,
  .back h2 {
    font-family: var(--font-display);
    font-size: 1.6rem;
    margin: 0 0 0.6rem;
  }
  .front p,
  .back p {
    font-size: 0.98rem;
    line-height: 1.6;
    margin: 0 0 0.9rem;
    max-width: 60ch;
  }

  .contents {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
    display: grid;
    gap: 0.45rem;
  }
  .contents-note {
    font-size: 0.82rem !important;
    color: var(--color-muted, #6b6257);
    margin: 0 0 0.8rem !important;
  }
  .contents li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.95rem;
    padding-bottom: 0.3rem;
  }
  .contents em {
    color: var(--color-muted, #6b6257);
    font-style: normal;
    font-size: 0.85rem;
    white-space: nowrap;
  }

  .chapter {
    padding: 2.5rem 0 1.5rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 18%, transparent);
  }
  .ch-num {
    font-family: var(--font-display);
    font-size: 0.95rem;
    letter-spacing: 0.18em;
    color: var(--color-muted, #6b6257);
    margin: 0 0 0.4rem;
  }
  .chapter h2 {
    font-family: var(--font-display);
    font-size: 1.55rem;
    line-height: 1.15;
    margin: 0 0 0.35rem;
  }
  .ch-src {
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted, #6b6257);
    margin: 0 0 1.1rem;
  }
  .chapter p {
    font-size: 1rem;
    line-height: 1.62;
    margin: 0 0 0.85rem;
    max-width: 60ch;
  }
  .ch-ask {
    margin: 1.4rem 0 1rem;
    padding: 1rem 1.15rem;
    border: 1.5px solid var(--color-ink, #2a2118);
    border-radius: 10px;
    background: var(--color-paper-2, #f6efe0);
  }
  .ch-ask-label {
    font-size: 0.72rem !important;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin: 0 0 0.35rem !important;
    color: var(--color-muted, #6b6257);
  }
  .ch-ask-q {
    font-family: var(--font-display);
    font-size: 1.2rem !important;
    line-height: 1.3 !important;
    margin: 0 !important;
  }
  .ch-note {
    font-size: 0.84rem !important;
    color: var(--color-muted, #6b6257);
    border-left: 2px solid color-mix(in srgb, var(--color-ink) 25%, transparent);
    padding-left: 0.85rem;
  }
  .back-end {
    margin-top: 1.5rem;
    font-size: 0.85rem !important;
    letter-spacing: 0.04em;
    color: var(--color-muted, #6b6257);
  }

  /* ---- print: the book, not the website ---- */
  @media print {
    @page {
      size: A4;
      margin: 20mm 18mm 18mm;
    }
    :global(body > header),
    :global(body > footer) {
      display: none !important;
    }
    .book {
      max-width: none;
      padding: 0;
    }
    .cover {
      min-height: 245mm;
      padding: 0 0 2.2rem;
      break-after: page;
      justify-content: flex-start;
    }
    .cover h1 {
      font-size: 42pt;
    }
    .cover-dl {
    font-size: 0.9rem;
    margin: 0.2rem 0 0;
  }
  .cover-dl a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .cover-art {
      max-width: 100%;
      margin-top: auto;
      padding-top: 10mm;
    }
    .front {
      break-after: page;
      border-bottom: 0;
      padding-bottom: 0;
    }
    .contents-block {
      break-before: page;
    }
    .contents {
      padding-bottom: 10mm;
    }
    .chapter {
      break-before: page;
      break-inside: avoid;
      border-bottom: 0;
      padding-top: 0;
    }
    .chapter:first-of-type {
      break-before: page;
    }
    .back {
      break-before: page;
      border-top: 0;
    }
    .chapter p,
    .front p,
    .back p {
      font-size: 11pt;
      line-height: 1.55;
      orphans: 3;
      widows: 3;
    }
    .ch-ask-q {
      font-size: 14pt !important;
    }
  }
</style>
