---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../components/BaseLayout.astro";
import Portrait from "../../components/Portrait.astro";
import ConceptCard from "../../components/ConceptCard.astro";
import Icon from "../../components/Icon.astro";
import { branchOf, lifespan } from "../../lib/site";
import credits from "../../data/credits.json";

export async function getStaticPaths() {
  const philosophers = await getCollection("philosophers");
  return philosophers.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const p = entry.data;
const b = branchOf(p.branch);
const { Content } = await render(entry);

const all = await getCollection("philosophers");
const concepts = await getCollection("concepts");
const others = all.filter((x) => x.id !== entry.id);
const sameTheme = others.filter((x) => x.data.branch === p.branch);
const neighbours = [...sameTheme, ...others.filter((x) => x.data.branch !== p.branch)].slice(0, 3);
const nearbyIdeas = concepts.filter((c) => c.data.branch === p.branch).slice(0, 3);

const credit = (credits as any[]).find((c) => c.slug === entry.id);

/** Commons filenames are not prose. "File:Zhang Lu-Laozi Riding an Ox (cropped).jpg"
 *  reads badly on the page, so show the work without the File: prefix or extension. */
function prettyTitle(raw: string) {
  return raw.replace(/^File:/i, "").replace(/\.(jpe?g|png)$/i, "").replace(/_/g, " ");
}

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: p.name,
  description: p.oneLiner,
  birthDate: String(p.birthYear),
  deathDate: String(p.deathYear),
  image: credit?.direct_url,
};
---

<BaseLayout title={`${p.name} — Little Thinker`} description={p.oneLiner}>
  <article class="detail" style={`--card-accent:${b.color}`}>
    <nav class="crumbs">
      <a href="/">Home</a><span aria-hidden="true">/</span>
      <a href="/philosophers">Philosophers</a><span aria-hidden="true">/</span>
      <span aria-current="page">{p.name}</span>
    </nav>

    <header class="detail-head">
      <Portrait
        file={p.heroImage}
        alt={p.heroImageAlt ?? `Portrait of ${p.name}`}
        monogram={p.monogram}
        size="lg"
      />
      <div>
        <p class="kicker">{b.name} · {p.years}</p>
        <h1>{p.name}</h1>
        <p class="lede">{p.oneLiner}</p>
        <p class="detail-place">{p.place} · lived {lifespan(p.birthYear, p.deathYear)}</p>
      </div>
    </header>

    <div class="detail-body">
      <div class="prose">
        <section class="qblock">
          <p class="qblock-label">Their big question</p>
          <p class="qblock-q">{p.bigQuestion}</p>
        </section>

        <Content />

        <blockquote class="pull">
          <p>&ldquo;{p.quote}&rdquo;</p>
          <cite set:html={p.quoteNote} />
        </blockquote>

        <h2>Three things worth knowing</h2>
        <ul class="facts">
          {p.facts.map((f) => <li set:html={f} />)}
        </ul>

        <section class="tryit">
          <p class="tryit-label"><Icon name="compass" size={15} /> Try it — think like {p.name.split(" ")[0]}</p>
          <p set:html={p.activity} />
        </section>

        {
          credit ? (
            <p class="side-small">
              {prettyTitle(credit.title)}
              {credit.author ? ` — ${credit.author}` : ""}{credit.license ? ` · ${credit.license}` : ""}. <a href={credit.source_url} rel="noopener">Wikimedia Commons</a>.
            </p>
          ) : (
            <p class="side-small">
              We have no portrait of {p.name.split(" ")[0]} that is both authentic and free to use, so this page uses
              a drawn mark rather than an invented face.
            </p>
          )
        }
      </div>

      <aside class="sidebox">
        <div class="side-block">
          <p class="side-h">Same shelf</p>
          {
            neighbours.map((x) => (
              <a class="side-link" href={`/philosophers/${x.id}`}>
                {x.data.name}
                <span>{x.data.bigQuestion}</span>
              </a>
            ))
          }
        </div>

        {
          nearbyIdeas.length > 0 && (
            <div class="side-block">
              <p class="side-h">Big ideas nearby</p>
              {nearbyIdeas.map((c) => (
                <a class="side-link" href={`/ideas/${c.id}`}>
                  {c.data.title}
                  <span>ages {c.data.agesMin}–{c.data.agesMax}</span>
                </a>
              ))}
            </div>
          )
        }

        <div class="side-block">
          <p class="side-h">Reading this together</p>
          <p class="side-small">
            Best read aloud by an adult, or read slowly. Keep the &ldquo;Try it&rdquo; box for after the story.
          </p>
        </div>
      </aside>
    </div>
  </article>

  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

</BaseLayout>
