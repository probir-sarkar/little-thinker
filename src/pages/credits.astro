---
import { Image } from "astro:assets";
import BaseLayout from "../components/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import credits from "../data/credits.json";

const images = import.meta.glob<{ default: ImageMetadata }>("/src/assets/images/*.{jpg,jpeg,png,webp}", { eager: true });

const rows = (credits as any[])
  .map((c) => {
    const key = Object.keys(images).find((k) => k.endsWith(`/${c.file}`));
    return { ...c, src: key ? images[key].default : undefined };
  })
  .sort((a, b) => String(a.slug).localeCompare(String(b.slug)));

const missing = rows.filter((r) => !r.src).map((r) => r.file);
const licences = [...new Set(rows.map((r) => r.license))];
---

<BaseLayout
  title="Image credits — Think Small"
  description="Every photograph and artwork on Think Small, with its author, licence and source."
>
  <header class="page-head">
    <p class="kicker">Credits</p>
    <h1>Where the pictures come from</h1>
    <p class="lede">
      Every image on this site is public domain or openly licensed, and this page is generated from the same JSON file
      the site is built from — so a picture cannot appear on a page without appearing here.
    </p>
  </header>

  {
    rows.length === 0 ? (
      <p>No credited images are currently bundled. Pages fall back to drawn monogram medallions and original SVG marks.</p>
    ) : (
      <>
        <p class="side-small">
          {rows.length} credited images · licences: {licences.join(", ")} · all sources on Wikimedia Commons.
        </p>
        <div class="credit-grid">
          {rows.map((r) => (
            <div class="credit">
              {r.src ? (
                <Image src={r.src} alt={r.title} widths={[400, 800]} sizes="(max-width: 700px) 100vw, 300px" format="webp" loading="lazy" />
              ) : (
                <div class="grid aspect-[4/3] place-items-center bg-paper-2">
                  <Icon name="eye" size={30} />
                </div>
              )}
              <div class="credit-body">
                <b>{r.title}</b>
                <span>{r.author}</span>
                <span>
                  <a href={r.source_url} rel="noopener">Source file</a>
                  {r.license_url ? <> · <a href={r.license_url} rel="noopener nofollow">licence text</a></> : null}
                </span>
                <span class="lic">{r.license}</span>
              </div>
            </div>
          ))}
        </div>
      </>
    )
  }

  {
    missing.length > 0 && (
      <p class="side-small" style="color:var(--muted)">
        Credited but not bundled in this build: {missing.join(", ")}.
      </p>
    )
  }

  <section class="how">
    <h2>Two honest notes</h2>
    <ol class="how-list">
      <li>
        <b>Some faces do not exist</b>
        <span>
          Socrates wrote nothing and nobody drew him from life. Any "portrait" of him is a later sculptor's idea, and
          this site treats it that way rather than as a photograph.
        </span>
      </li>
      <li>
        <b>Icons and charts are ours</b>
        <span>
          The 24 line icons, the two owl and ladder illustrations and every chart on the site are drawn or generated for
          this project — hand-written SVG paths, no icon library, no stock assets.
        </span>
      </li>
    </ol>
    <p class="how-foot">
      <a href="/philosophers">Back to the philosophers &rarr;</a>
    </p>
  </section>
</BaseLayout>
