---
import { getCollection } from "astro:content";
import BaseLayout from "../components/BaseLayout.astro";
import { branchList, branchOf } from "../lib/site";

const concepts = (await getCollection("concepts")).sort((a, b) => a.data.agesMin - b.data.agesMin);
const philosophers = await getCollection("philosophers");

const byBranch = concepts.reduce<Record<string, number>>((acc, c) => {
  acc[c.data.branch] = (acc[c.data.branch] ?? 0) + 1;
  return acc;
}, {});

const themes: Record<string, string> = {
  "how-to-live": "PSHE · values · behaviour",
  "what-is-real": "Science · reality · time",
  "how-we-know": "Evidence · critical thinking · media literacy",
  "who-am-i": "Identity · wellbeing · self",
  together: "Citizenship · rules · democracy",
  beauty: "Art · music · creative writing",
};
---

<BaseLayout
  title="For grown-ups — Little Thinker"
  description="How to run a ten-minute philosophy session with a child or a class, plus the themes and age bands of every page."
>
  <header class="page-head">
    <p class="kicker">For grown-ups</p>
    <h1>How to use this with a child or a class</h1>
    <p class="lede">
      You do not need to know any philosophy. You need about ten minutes and the willingness to say &ldquo;I don&rsquo;t
      know&rdquo; out loud.
    </p>
  </header>

  <div class="detail-body">
    <div class="prose">
      <h2>The ten-minute ritual</h2>
      <ol class="how-list">
        <li>
          <b>Read the question only</b>
          <span>Read the title. Stop. Ask what they think before anything else on the page is read. This is the whole trick.</span>
        </li>
        <li>
          <b>Read the story together</b>
          <span>Keep it short — the story is a doorway, not the lesson.</span>
        </li>
        <li>
          <b>Do the Try it box</b>
          <span>Moving, drawing, timing, watching. All the retention lives here.</span>
        </li>
        <li>
          <b>Ask two of the Talk about it questions</b>
          <span>Then stop. Never resolve it. Leave the question open on purpose.</span>
        </li>
      </ol>

      <h2>What makes a philosophy conversation with children work</h2>
      <ul class="facts">
        <li><b>Answer with a question.</b> &ldquo;What do you mean by fair?&rdquo; beats any definition you could give.</li>
        <li>
          <b>Name the move, not the answer.</b> &ldquo;You just gave a reason — that&rsquo;s what philosophers do&rdquo;
          teaches more than praise for being right.
        </li>
        <li><b>Let silence sit for five seconds.</b> Children need the gap to think inside. Adults normally fill it.</li>
        <li><b>Let them disagree with you.</b> If they can, they have understood the page.</li>
        <li>
          <b>Do not settle it.</b> A page that ends in a conclusion teaches that thinking is a race to a finish line.
        </li>
      </ul>
    </div>
  </div>

  <h2>Themes, if you need them for planning</h2>
  <div class="table-wrap">
    <table class="ctable">
      <thead>
        <tr>
          <th>Big idea</th>
          <th>Theme</th>
          <th>Curriculum area it usually sits in</th>
          <th>Ages</th>
          <th>Opening question</th>
        </tr>
      </thead>
      <tbody>
        {
          concepts.map((c) => (
            <tr>
              <td>
                <a href={`/ideas/${c.id}`}>{c.data.title}</a>
              </td>
              <td>{branchOf(c.data.branch).name}</td>
              <td>{themes[c.data.branch]}</td>
              <td>
                {c.data.agesMin}–{c.data.agesMax}
              </td>
              <td set:html={c.data.talk[0]} />
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <div class="detail-body">
    <div class="prose">
      <h2>The philosophers, for your own reference</h2>
      <p>
        {philosophers.length} thinkers, one page each, chosen so that no single tradition carries the whole subject — and so that a child
        meets at least one person who is not a European man. Each page names its own big question, which is the line
        worth reading aloud before you open the story.
      </p>
      <ul class="facts">
        {
          philosophers.map((p) => (
            <li>
              <b>
                <a href={`/philosophers/${p.id}`}>{p.data.name}</a> — {p.data.years}
              </b>{" "}
              {p.data.bigQuestion}
            </li>
          ))
        }
      </ul>

      <h2>If it goes well</h2>
      <p>
        You will know it worked because the child asks you something you cannot answer. Write that question down
        somewhere you will both see it again. It is the next lesson, and neither of you needs to have solved it.
      </p>

      <p class="side-small">
        The pictures on this site are historical artworks and photographs, all in the public domain or openly
        licensed — <a href="/credits">each one is credited here</a>.
      </p>
    </div>

    <aside class="sidebox">
      <div class="side-block">
        <p class="side-h">By theme</p>
        {
          branchList
            .filter((b) => byBranch[b.key])
            .map((b) => (
              <a class="side-link" href="/ideas">
                {b.name}
                <span>{byBranch[b.key]} ideas · {b.note}</span>
              </a>
            ))
        }
      </div>
      <div class="side-block">
        <p class="side-h">Print it</p>
        <p class="side-small">
          Every page prints cleanly, so you can hand out a story and its activity on paper without a screen in the
          room.
        </p>
      </div>
    </aside>
  </div>
</BaseLayout>
