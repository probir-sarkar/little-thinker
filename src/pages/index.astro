---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../components/BaseLayout.astro";
import PhilosopherCard from "../components/PhilosopherCard.astro";
import ConceptCard from "../components/ConceptCard.astro";
import Icon from "../components/Icon.astro";
import StoryArt from "../components/StoryArt.astro";
import WonderBoard from "../components/islands/WonderBoard.tsx";
import wonders from "../data/wonders.json";
import { countOf, wordOf } from "../lib/count";
import credits from "../data/credits.json";

const philosophers = await getCollection("philosophers");
const concepts = await getCollection("concepts");
const stories = await getCollection("stories");

// Three, not six: the row says "Three to start with" and links to the full
// shelf, so the count on screen matches the count in the words. Three ideas
// too, for the same reason — a fourth would wrap alone onto a second row.
const picked = ["socrates", "hypatia", "confucius"];
const shelf = picked.map((id) => philosophers.find((p) => p.id === id)!).filter(Boolean);
const ideaShelf = ["fairness", "truth", "time"]
  .map((id) => concepts.find((c) => c.id === id)!)
  .filter(Boolean);
const storyShelf = ["the-cave", "the-boy-who-cried-wolf", "the-fox-and-the-grapes"]
  .map((id) => stories.find((s) => s.id === id)!)
  .filter(Boolean);
const ideaDoorNamed = 4;

// Decorative photographs, only if the credited ones were fetched.
const sceneImages = import.meta.glob<{ default: ImageMetadata }>("/src/assets/images/*.{jpg,jpeg,png,webp}", {
  eager: true,
});
// Plain-language captions. The filenames and licence strings live on /credits,
// because "Noctua minima.jpg — George Edwards, Public domain" is not a caption
// for a seven-year-old.
const SCENE_CAPTIONS: Record<string, string> = {
  "scene-owl": "An owl, from an 18th-century natural history plate",
  "scene-stars": "A chart of the northern and southern night skies",
  "scene-map": "A world map drawn when much of it was still unknown",
  "scene-library": "A reading room, from an old engraving",
};

const scenes = (credits as any[])
  .filter((c) => String(c.slug).startsWith("scene-"))
  .slice(0, 3)
  .map((c) => {
    const key = Object.keys(sceneImages).find((k) => k.endsWith(`/${c.file}`));
    return key ? { ...c, src: sceneImages[key].default } : null;
  })
  .filter(Boolean) as any[];
---

<BaseLayout
  title="Little Thinker — philosophy for children"
  description="Philosophy for children: one big question per page, one philosopher per page."
>
  <section class="hero">
    <div class="hero-left">
      <p class="kicker">Philosophy for children 5–12</p>
      <h1>Big questions,<br />cut down to size.</h1>
      <p class="lede">
        One idea per page. One philosopher per page. No answers at the bottom — just better questions, and things to try
        at the kitchen table.
      </p>
      <div class="hero-doors">
        <a class="door" href="/philosophers">
          <span class="door-n">01</span>
          <span class="door-t">Meet the philosophers</span>
          <span class="door-s">{countOf(philosophers.length, "person", "people")} who asked too many questions</span>
          <span class="door-a" aria-hidden="true"><Icon name="door" size={22} /></span>
        </a>
        <a class="door" href="/ideas">
          <span class="door-n">02</span>
          <span class="door-t">Start with a big idea</span>
          <span class="door-s">Fairness, time, truth, courage and {wordOf(concepts.length - ideaDoorNamed)} more</span>
          <span class="door-a" aria-hidden="true"><Icon name="idea" size={22} /></span>
        </a>
      </div>
    </div>

    <WonderBoard client:load wonders={wonders} />
  </section>

  {
    scenes.length > 0 && (
      <section class="scene">
        {scenes.map((s: any) => (
          <figure>
            <Image
              src={s.src}
              alt={s.title}
              widths={[400, 800]}
              sizes="(max-width: 900px) 100vw, 33vw"
              format="webp"
              loading="lazy"
            />
            <figcaption>{SCENE_CAPTIONS[s.slug] ?? s.title}</figcaption>
          </figure>
        ))}
      </section>
    )
  }

  {
    scenes.length > 0 && (
      <p class="pb-5 text-[0.84rem] text-muted">
        Illustrations from Wikimedia Commons, each credited beside the picture.
      </p>
    )
  }

  <section class="row">
    <div class="row-head">
      <h2>Three to start with</h2>
      <a class="more" href="/philosophers">All {philosophers.length} &rarr;</a>
    </div>
    <div class="grid grid-shelf">
      {shelf.map((p) => <PhilosopherCard entry={p} />)}
    </div>
  </section>

  <section class="row">
    <div class="row-head">
      <h2>Start with a big idea</h2>
      <a class="more" href="/ideas">All {concepts.length} &rarr;</a>
    </div>
    <div class="grid grid-shelf">
      {ideaShelf.map((c) => <ConceptCard entry={c} />)}
    </div>
  </section>

  <section class="row">
    <div class="row-head">
      <h2>A story, told out loud</h2>
      <a class="more" href="/stories">All {stories.length} &rarr;</a>
    </div>
    <div class="grid grid-3">
      {
        storyShelf.map((s) => (
          <a class="story-card" href={`/stories/${s.id}`}>
            {s.data.heroImage && <StoryArt file={s.data.heroImage} alt={s.data.heroImageAlt} />}
            <p class="story-src">{s.data.sourceShort}</p>
            <h2>{s.data.title}</h2>
            <p>{s.data.hook}</p>
            <p class="story-meta">Ages {s.data.agesMin}&ndash;{s.data.agesMax}</p>
          </a>
        ))
      }
    </div>
  </section>

  <section class="how">
    <h2>How every page works</h2>
    <ol class="how-list">
      <li><b>The question</b><span>One line any child can hold in their head.</span></li>
      <li><b>The story</b><span>A real philosopher, a real problem, no jargon.</span></li>
      <li><b>Try it</b><span>Two minutes, a sheet of paper, something to do.</span></li>
      <li><b>Talk about it</b><span>Three questions with nothing printed underneath.</span></li>
    </ol>
    <p class="how-foot"><a href="/grown-ups">Reading this with a class? Start here &rarr;</a></p>
  </section>
</BaseLayout>
