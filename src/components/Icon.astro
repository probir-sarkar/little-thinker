---
/**
 * Inline SVG icon from the hand-authored sprite in /public/icons.svg.
 * Falls back to a visible placeholder if a name is misspelled, so a bad
 * icon name shows up in review instead of rendering an invisible blank.
 */
interface Props {
  name: string;
  size?: number;
  class?: string;
  label?: string;
}
const { name, size = 20, class: klass = "", label } = Astro.props;
const href = `/icons.svg#icon-${name}`;
---

<svg
  class={`icon ${klass}`}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  focusable="false"
>
  <use href={href}></use>
</svg>
