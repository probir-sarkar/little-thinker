---
/**
 * A philosopher's portrait, or an engraved monogram plate when no portrait is
 * known. Both paths render at the same size, border weight and paper tone, so
 * a card with no photograph reads as deliberate rather than as a broken image.
 *
 * Deliberate choice: the fallback is a monogram, not a drawn face. Inventing a
 * likeness for someone nobody ever painted would be the one thing this site
 * must not do — and an icon glyph in a portrait slot reads as UI, not as a
 * person. Letters are honest about being letters.
 *
 * Images are optimised at build time by astro:assets (sharp).
 */
import { Image } from "astro:assets";

interface Props {
  /** Credit-verified image file, e.g. "socrates.jpg". Empty for "none known". */
  file?: string | null;
  alt?: string | null;
  monogram: string;
  size?: "sm" | "lg" | "md";
}

const { file, alt, monogram, size = "md" } = Astro.props;

// Every image in src/assets/images, keyed by filename, resolved at build time.
const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/*.{jpg,jpeg,png,webp}",
  { eager: true },
);
const key = file ? Object.keys(images).find((k) => k.endsWith(`/${file}`)) : undefined;
const src = key ? images[key].default : undefined;
const sizeClass = size === "sm" ? "portrait-sm" : size === "lg" ? "portrait-lg" : "";
const px = size === "sm" ? 128 : size === "lg" ? 340 : 240;
---

{
  src ? (
    <span class={`portrait ${sizeClass}`}>
      <Image
        src={src}
        alt={alt ?? `Portrait of ${monogram}`}
        widths={[px, px * 2]}
        sizes={`${px}px`}
        format="webp"
        loading="lazy"
        decoding="async"
      />
    </span>
  ) : (
    <span class={`medal ${sizeClass}`} role="img" aria-label={alt ?? `No portrait known for ${monogram}`}>
      <span class="medal-initials" aria-hidden="true">{monogram}</span>
    </span>
  )
}
