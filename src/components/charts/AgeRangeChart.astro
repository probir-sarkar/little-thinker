---
/**
 * "Reading ladder" — every idea's suggested age band as a range on one axis.
 * Read it as: which ideas you can hand to a six-year-old, and which need a
 * nine-year-old. Ranges are suggestions from the content, not gates.
 */
import { branchOf } from "../../lib/site";
import Icon from "../Icon.astro";

interface Idea {
  title: string;
  branch: string;
  agesMin: number;
  agesMax: number;
  href: string;
}
interface Props {
  ideas: Idea[];
  min?: number;
  max?: number;
}
const { ideas, min = 5, max = 12 } = Astro.props;
const rows = [...ideas].sort((a, b) => a.agesMin - b.agesMin || a.agesMax - b.agesMax);

const rowH = 30;
const padLeft = 210;
const padRight = 40;
const padTop = 34;
const W = 760;
const H = padTop + rows.length * rowH + 20;
const plotW = W - padLeft - padRight;
const x = (age: number) => padLeft + ((age - min) / (max - min)) * plotW;
const step = 1;
const ticks: number[] = [];
for (let t = min; t <= max; t += step) ticks.push(t);
---

<div class="chart">
  <p class="chart-head"><Icon name="ladder" size={14} /> Chart · suggested age bands</p>
  <h2 class="chart-title">The reading ladder</h2>
  <div class="chart-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Chart showing the suggested age range of every big idea">
      {ticks.map((t) => (
        <g>
          <line x1={x(t)} y1={padTop - 12} x2={x(t)} y2={H - 14} stroke="#dccfb8" stroke-width={t % 2 === 0 ? 1 : 0.5} />
          <text class="chart-tick" x={x(t)} y={padTop - 18} text-anchor="middle">{t}</text>
        </g>
      ))}
      <text class="chart-tick" x={padLeft} y={padTop - 30} text-anchor="start">age</text>
      {rows.map((r, i) => {
        const y = padTop + i * rowH;
        const b = branchOf(r.branch);
        return (
          <g class="chart-bar">
            <a href={r.href}>
              <text class="chart-label" x={padLeft - 12} y={y + 15} text-anchor="end">{r.title}</text>
              <line
                x1={x(r.agesMin)}
                y1={y + 11}
                x2={x(r.agesMax)}
                y2={y + 11}
                stroke={b.color}
                stroke-width="9"
                stroke-linecap="round"
                opacity="0.4"
              />
              <circle cx={x(r.agesMin)} cy={y + 11} r="5" fill={b.color} stroke="#221c17" stroke-width="1.4" />
              <circle cx={x(r.agesMax)} cy={y + 11} r="5" fill="#fbf6ec" stroke={b.color} stroke-width="2.6" />
            </a>
          </g>
        );
      })}
    </svg>
  </div>
  <p class="chart-note">
    Suggested, not enforced. The story text on every page reads younger than its questions.
  </p>
</div>
