{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "think-small-philosophy",
  "compatibility_date": "2025-09-01",
  // No "main", no bindings. Cloudflare's Astro framework guide: for a fully
  // static Astro project the config is just an `assets` block, "because you're
  // only serving static assets, so no Worker code is needed".
  "assets": {
    "directory": "./dist",
    // Load-bearing. With "none" the root path 404s; with anything other than
    // auto-trailing-slash every extensionless link this site generates breaks.
    "html_handling": "auto-trailing-slash",
    // Serves src/pages/404.astro for unmatched routes.
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true }
}
